        <!-- Title -->
        <mxCell id="title" value="&lt;b style=&quot;font-size: 15px;&quot;&gt;Figure 3.4.1: Logical Database Design (Relational Multi-Tenant Model &amp;amp; Integrity Constraints)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="64" y="30" width="700" height="30" as="geometry"/>
        </mxCell>

        <!-- ==================== TIER 1: ORGANIZATIONS & CHAIN HEADS ==================== -->
        <mxCell id="t_org" value="&lt;b&gt;ORGANIZATIONS&lt;/b&gt; [Logical Root]&lt;hr&gt;+ &lt;b&gt;id&lt;/b&gt; : UUID &lt;b&gt;&amp;lt;PK&amp;gt;&lt;/b&gt;&lt;br&gt;+ name : VARCHAR(255) [NOT NULL]&lt;br&gt;+ slug : VARCHAR(100) &lt;b&gt;&amp;lt;UQ&amp;gt;&lt;/b&gt;&lt;br&gt;+ status : ENUM('ACTIVE', 'SUSPENDED')&lt;br&gt;+ created_at : TIMESTAMP(6)&lt;br&gt;+ updated_at : TIMESTAMP(6)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=10;fontSize=10.5;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="64" y="80" width="320" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="t_chain_heads" value="&lt;b&gt;CHAIN_HEADS&lt;/b&gt; [Concurrency Lock Target]&lt;hr&gt;+ &lt;b&gt;organization_id&lt;/b&gt; : UUID &lt;b&gt;&amp;lt;PK, FK-&amp;gt;ORGANIZATIONS.id&amp;gt;&lt;/b&gt;&lt;br&gt;+ head_sequence_number : BIGINT [NOT NULL, DEF 0]&lt;br&gt;+ head_record_hash : CHAR(64) [SHA-256 Hex]&lt;br&gt;+ genesis_hash : CHAR(64) [64 Zeros Genesis]&lt;br&gt;+ updated_at : TIMESTAMP(6) [ON UPDATE CURRENT]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=10;fontSize=10.5;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="444" y="80" width="320" height="120" as="geometry"/>
        </mxCell>

        <!-- ==================== TIER 2: API KEYS & WORM CHECKPOINTS ==================== -->
        <mxCell id="t_api_keys" value="&lt;b&gt;API_KEYS&lt;/b&gt; [Zero-Trust Ingestion Credentials]&lt;hr&gt;+ &lt;b&gt;id&lt;/b&gt; : UUID &lt;b&gt;&amp;lt;PK&amp;gt;&lt;/b&gt;&lt;br&gt;+ &lt;b&gt;organization_id&lt;/b&gt; : UUID &lt;b&gt;&amp;lt;FK-&amp;gt;ORGANIZATIONS.id&amp;gt;&lt;/b&gt;&lt;br&gt;+ key_prefix : VARCHAR(16) [NOT NULL]&lt;br&gt;+ key_hash : CHAR(64) &lt;b&gt;&amp;lt;UQ, SHA-256&amp;gt;&lt;/b&gt;&lt;br&gt;+ label : VARCHAR(100)&lt;br&gt;+ status : ENUM('ACTIVE', 'REVOKED')&lt;br&gt;+ created_at : TIMESTAMP(6)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=10;fontSize=10.5;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="64" y="240" width="320" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="t_checkpoints" value="&lt;b&gt;CHECKPOINTS&lt;/b&gt; [WORM Out-of-Band Anchors]&lt;hr&gt;+ &lt;b&gt;id&lt;/b&gt; : UUID &lt;b&gt;&amp;lt;PK&amp;gt;&lt;/b&gt;&lt;br&gt;+ &lt;b&gt;organization_id&lt;/b&gt; : UUID &lt;b&gt;&amp;lt;FK-&amp;gt;ORGANIZATIONS.id&amp;gt;&lt;/b&gt;&lt;br&gt;+ sequence_number : BIGINT [Snapshot Seq]&lt;br&gt;+ checkpoint_hash : CHAR(64) [Chain Digest]&lt;br&gt;+ storage_provider : ENUM('AWS_S3', 'MINIO', 'LOCAL')&lt;br&gt;+ s3_bucket : VARCHAR(100)&lt;br&gt;+ s3_object_key : VARCHAR(255)&lt;br&gt;+ s3_version_id : VARCHAR(100) [WORM Version ID]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=10;fontSize=10.5;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="444" y="240" width="320" height="155" as="geometry"/>
        </mxCell>

        <!-- ==================== TIER 3: AUDIT EVENTS (CRYPTOGRAPHIC CHAIN) ==================== -->
        <mxCell id="t_audit_events" value="&lt;b&gt;AUDIT_EVENTS&lt;/b&gt; [Immutable Append-Only Cryptographic Chain Table]&lt;hr&gt;+ &lt;b&gt;id&lt;/b&gt; : UUID &lt;b&gt;&amp;lt;PK&amp;gt;&lt;/b&gt;&lt;br&gt;+ &lt;b&gt;organization_id&lt;/b&gt; : UUID &lt;b&gt;&amp;lt;FK-&amp;gt;ORGANIZATIONS.id&amp;gt;&lt;/b&gt;&lt;br&gt;+ &lt;b&gt;sequence_number&lt;/b&gt; : BIGINT [NOT NULL, STRICTLY MONOTONIC 1, 2, 3...]&lt;br&gt;+ event_action : VARCHAR(100) [NOT NULL]&lt;br&gt;+ actor_id : VARCHAR(100) [NOT NULL]&lt;br&gt;+ target_id : VARCHAR(100) [NOT NULL]&lt;br&gt;+ payload : TEXT [Canonical RFC 8785 JSON representation]&lt;br&gt;+ &lt;b&gt;record_hash&lt;/b&gt; : CHAR(64) [SHA-256( JCS(payload) || prev_record_hash )]&lt;br&gt;+ &lt;b&gt;prev_record_hash&lt;/b&gt; : CHAR(64) [Cryptographic predecessor link]&lt;br&gt;+ created_at : TIMESTAMP(6) [Microsecond UTC timestamp]&lt;hr&gt;&lt;b&gt;UQ_org_seq&lt;/b&gt; : UNIQUE (organization_id, sequence_number)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=10;fontSize=10.5;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="64" y="430" width="700" height="195" as="geometry"/>
        </mxCell>

        <!-- ==================== TIER 4: VERIFICATION RUNS ==================== -->
        <mxCell id="t_verification_runs" value="&lt;b&gt;VERIFICATION_RUNS&lt;/b&gt; [Audit Proof Reports &amp;amp; Tamper Telemetry]&lt;hr&gt;+ &lt;b&gt;id&lt;/b&gt; : UUID &lt;b&gt;&amp;lt;PK&amp;gt;&lt;/b&gt;&lt;br&gt;+ &lt;b&gt;organization_id&lt;/b&gt; : UUID &lt;b&gt;&amp;lt;FK-&amp;gt;ORGANIZATIONS.id&amp;gt;&lt;/b&gt;&lt;br&gt;+ verified_from_sequence : BIGINT&lt;br&gt;+ verified_to_sequence : BIGINT&lt;br&gt;+ result_status : ENUM('SUCCESS', 'TAMPER_DETECTED', 'SEQUENCE_GAP')&lt;br&gt;+ discrepancies_count : INT&lt;br&gt;+ failure_reason : TEXT [Identifies sequence &amp;amp; mismatch delta]&lt;br&gt;+ verified_at : TIMESTAMP(6)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;spacingLeft=10;fontSize=10.5;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="64" y="660" width="700" height="150" as="geometry"/>
