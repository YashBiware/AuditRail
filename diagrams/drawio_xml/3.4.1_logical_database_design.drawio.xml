        </mxCell>

        <!-- Table: audit_events -->
        <mxCell id="tbl_audit_events" value="&lt;b&gt;AUDIT_EVENTS&lt;/b&gt; [Immutable Cryptographic Chain Table]&#xa;--&#xa;+ &lt;b&gt;id&lt;/b&gt; : UUID &lt;b&gt;&amp;lt;PK&amp;gt;&lt;/b&gt;&#xa;+ &lt;b&gt;organization_id&lt;/b&gt; : UUID &lt;b&gt;&amp;lt;FK-&amp;gt;ORGANIZATIONS.id&amp;gt;&lt;/b&gt;&#xa;+ &lt;b&gt;sequence_number&lt;/b&gt; : BIGINT [NOT NULL, MONOTONIC]&#xa;+ event_action : VARCHAR(100) [NOT NULL]&#xa;+ actor_id : VARCHAR(100) [NOT NULL]&#xa;+ target_id : VARCHAR(100) [NOT NULL]&#xa;+ payload : TEXT [Canonical RFC 8785 JSON representation]&#xa;+ &lt;b&gt;record_hash&lt;/b&gt; : CHAR(64) [SHA-256(JCS(payload) || prev_record_hash)]&#xa;+ &lt;b&gt;prev_record_hash&lt;/b&gt; : CHAR(64) [Cryptographic link to seq-1]&#xa;+ created_at : TIMESTAMP(6) [Microsecond UTC timestamp]&#xa;--&#xa;&lt;b&gt;UQ_tenant_seq&lt;/b&gt; : UNIQUE(organization_id, sequence_number)" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#d5e8d4;strokeColor=#82b366;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;" vertex="1" parent="1">
          <mxGeometry x="410" y="260" width="380" height="250" as="geometry"/>
        </mxCell>

        <!-- Table: checkpoints -->
        <mxCell id="tbl_checkpoints" value="&lt;b&gt;CHECKPOINTS&lt;/b&gt; [WORM Out-of-Band Anchors]&#xa;--&#xa;+ &lt;b&gt;id&lt;/b&gt; : UUID &lt;b&gt;&amp;lt;PK&amp;gt;&lt;/b&gt;&#xa;+ &lt;b&gt;organization_id&lt;/b&gt; : UUID &lt;b&gt;&amp;lt;FK-&amp;gt;ORGANIZATIONS.id&amp;gt;&lt;/b&gt;&#xa;+ sequence_number : BIGINT [Milestone Sequence Number]&#xa;+ checkpoint_hash : CHAR(64) [Chain Head Digest at Snapshot]&#xa;+ storage_provider : ENUM('AWS_S3', 'MINIO', 'LOCAL')&#xa;+ s3_bucket : VARCHAR(100)&#xa;+ s3_object_key : VARCHAR(255)&#xa;+ s3_version_id : VARCHAR(100) [S3 Object Version Reference]&#xa;+ created_at : TIMESTAMP(6)" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#fff2cc;strokeColor=#d6b656;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;" vertex="1" parent="1">
