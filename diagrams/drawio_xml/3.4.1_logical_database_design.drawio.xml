        <mxCell id="tbl_chain_heads" value="&lt;b&gt;CHAIN_HEADS&lt;/b&gt; [Concurrency Lock Target]&#xa;--&#xa;+ &lt;b&gt;organization_id&lt;/b&gt; : UUID &lt;b&gt;&amp;lt;PK, FK-&amp;gt;ORGANIZATIONS.id&amp;gt;&lt;/b&gt;&#xa;+ head_sequence_number : BIGINT [NOT NULL, DEFAULT 0]&#xa;+ head_record_hash : CHAR(64) [SHA-256 Hex]&#xa;+ genesis_hash : CHAR(64) [SHA-256 Hex]&#xa;+ updated_at : TIMESTAMP(6) [ON UPDATE CURRENT_TIMESTAMP]" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#ffe6cc;strokeColor=#d79b00;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=left;" vertex="1" parent="1">
